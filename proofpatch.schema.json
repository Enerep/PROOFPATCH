{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Enerep/PROOFPATCH/master/proofpatch.schema.json",
  "title": "ProofPatch configuration",
  "type": "object",
  "additionalProperties": false,
  "$comment": "The CLI also validates parsed URL hosts and unique names after trimming whitespace. Script discovery when checks is omitted depends on the local package.json.",
  "allOf": [
    {
      "if": { "required": ["checks"], "properties": { "checks": { "maxItems": 0 } } },
      "then": { "required": ["browser"], "properties": { "browser": { "type": "object" } } }
    }
  ],
  "properties": {
    "$schema": { "$ref": "#/$defs/nonEmptyString" },
    "checks": {
      "type": "array",
      "description": "Commands to run. Names must be unique after trimming whitespace. An empty array requires browser scenarios.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": { "$ref": "#/$defs/nonEmptyString" },
          "command": { "$ref": "#/$defs/nonEmptyString" },
          "timeoutMs": { "$ref": "#/$defs/timeout", "default": 120000 }
        }
      }
    },
    "browser": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseUrl", "scenarios"],
          "properties": {
            "baseUrl": { "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\s\\\\]+(?:/[^?#\\s\\\\]*)?$" },
            "startCommand": { "$ref": "#/$defs/nonEmptyString" },
            "startupTimeoutMs": { "$ref": "#/$defs/timeout", "default": 30000 },
            "timeoutMs": { "$ref": "#/$defs/timeout", "default": 15000 },
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "description": "Scenarios run in isolated browser contexts. Names must be unique after trimming whitespace.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "$ref": "#/$defs/nonEmptyString" },
                  "path": { "type": "string", "pattern": "^/(?!/)[^\\\\\\u0000-\\u001f\\u007f]*$", "default": "/" },
                  "steps": { "type": "array", "items": { "$ref": "#/$defs/step" }, "default": [] }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "pattern": "\\S" },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "selector"],
          "properties": {
            "action": { "enum": ["click", "expectVisible"] },
            "selector": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "selector", "value"],
          "properties": {
            "action": { "const": "fill" },
            "selector": { "$ref": "#/$defs/nonEmptyString" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "text"],
          "properties": {
            "action": { "const": "expectText" },
            "text": { "$ref": "#/$defs/nonEmptyString" },
            "selector": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    }
  }
}
