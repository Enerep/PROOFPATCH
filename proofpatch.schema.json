{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Enerep/PROOFPATCH/master/proofpatch.schema.json",
  "title": "ProofPatch configuration",
  "type": "object",
  "additionalProperties": false,
  "$comment": "The CLI also validates parsed URL hosts, unique names after trimming whitespace, unique requirement IDs, and references to declared requirement IDs. It requires step forMs to be strictly less than the effective browser.timeoutMs. Script discovery when checks is omitted depends on the local package.json.",
  "allOf": [
    {
      "if": { "required": ["checks"], "properties": { "checks": { "maxItems": 0 } } },
      "then": {
        "anyOf": [
          { "required": ["browser"], "properties": { "browser": { "type": "object" } } },
          { "required": ["requirements"], "properties": { "requirements": { "minItems": 1 } } }
        ]
      }
    }
  ],
  "properties": {
    "$schema": { "$ref": "#/$defs/nonEmptyString" },
    "requirements": {
      "type": "array",
      "default": [],
      "description": "Requirements to track. IDs must be unique. Descriptions are trimmed by the CLI.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/requirementId" },
          "description": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "checks": {
      "type": "array",
      "description": "Commands to run. Names must be unique after trimming whitespace. An empty array requires browser scenarios or declared requirements.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": { "$ref": "#/$defs/nonEmptyString" },
          "command": { "$ref": "#/$defs/nonEmptyString" },
          "timeoutMs": { "$ref": "#/$defs/timeout", "default": 120000 },
          "requirements": { "$ref": "#/$defs/requirementReferences" }
        }
      }
    },
    "browser": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseUrl", "scenarios"],
          "properties": {
            "baseUrl": { "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\s\\\\]+(?:/[^?#\\s\\\\]*)?$" },
            "startCommand": { "$ref": "#/$defs/nonEmptyString" },
            "startupTimeoutMs": { "$ref": "#/$defs/timeout", "default": 30000 },
            "timeoutMs": { "$ref": "#/$defs/timeout", "default": 15000 },
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "description": "Scenarios run in isolated browser contexts. Names must be unique after trimming whitespace.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "$ref": "#/$defs/nonEmptyString" },
                  "path": { "type": "string", "pattern": "^/(?!/)[^\\\\\\u0000-\\u001f\\u007f]*$", "default": "/" },
                  "steps": { "type": "array", "items": { "$ref": "#/$defs/step" }, "default": [] },
                  "requirements": { "$ref": "#/$defs/requirementReferences" }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "pattern": "\\S" },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "observationWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000,
      "default": 0,
      "description": "The expectation must be observed matching across this duration within the action timeout. Must be strictly less than browser.timeoutMs."
    },
    "requirementId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "not": { "pattern": "\\s" } },
    "requirementReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirementId" },
      "uniqueItems": true,
      "default": [],
      "description": "IDs of declared requirements covered by this check or scenario."
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "selector"],
          "properties": {
            "action": { "enum": ["click", "expectVisible"] },
            "selector": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "selector", "value"],
          "properties": {
            "action": { "const": "fill" },
            "selector": { "$ref": "#/$defs/nonEmptyString" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "text"],
          "properties": {
            "action": { "const": "expectText" },
            "text": { "$ref": "#/$defs/nonEmptyString" },
            "selector": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "selector", "count"],
          "properties": {
            "action": { "const": "expectCount" },
            "selector": { "$ref": "#/$defs/nonEmptyString" },
            "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "forMs": { "$ref": "#/$defs/observationWindow" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "selector"],
          "properties": {
            "action": { "const": "expectHidden" },
            "selector": { "$ref": "#/$defs/nonEmptyString" },
            "forMs": { "$ref": "#/$defs/observationWindow" }
          }
        }
      ]
    }
  }
}
